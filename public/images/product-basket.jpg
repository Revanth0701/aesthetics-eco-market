
<!-- This is a base64 encoded image representing a handwoven basket -->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <rect width="800" height="800" fill="#f9f5f0"/>
  <g transform="translate(400, 400)">
    <g stroke="#dda15e" stroke-width="12" fill="none">
      <!-- Handwoven basket -->
      <ellipse cx="0" cy="100" rx="200" ry="80" />
      <path d="M-200,100 C-180,-100 180,-100 200,100" />
      
      <!-- Basket weave pattern -->
      <path d="M-180,0 L180,0" stroke-dasharray="20,20" />
      <path d="M-160,-50 L160,-50" stroke-dasharray="20,20" />
      <path d="M-120,-100 L120,-100" stroke-dasharray="20,20" />
      
      <path d="M-180,50 L180,50" stroke-dasharray="20,20" />
      
      <!-- Vertical weave lines -->
      <path d="M-150,-90 L-150,90" stroke-dasharray="15,15" />
      <path d="M-75,-90 L-75,90" stroke-dasharray="15,15" />
      <path d="M0,-90 L0,90" stroke-dasharray="15,15" />
      <path d="M75,-90 L75,90" stroke-dasharray="15,15" />
      <path d="M150,-90 L150,90" stroke-dasharray="15,15" />
    </g>
    <text x="0" y="220" font-family="Arial" font-size="32" fill="#774936" text-anchor="middle">Handwoven Basket</text>
  </g>
</svg>
