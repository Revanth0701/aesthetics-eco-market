
<!-- This is a base64 encoded image representing handmade pottery -->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <rect width="800" height="800" fill="#f9f5f0"/>
  <g transform="translate(400, 400)">
    <g stroke="#976741" stroke-width="12" fill="none">
      <!-- Pottery vase -->
      <path d="M0,-200 C-120,-180 -150,-100 -120,0 C-100,80 -60,150 0,200 C60,150 100,80 120,0 C150,-100 120,-180 0,-200" />
      
      <!-- Decorative patterns -->
      <path d="M-90,-100 L90,-100" stroke-dasharray="10,15" />
      <path d="M-105,-50 L105,-50" stroke-dasharray="15,10" />
      <path d="M-110,0 L110,0" stroke-dasharray="10,10" />
      <path d="M-100,50 L100,50" stroke-dasharray="15,15" />
      <path d="M-70,100 L70,100" stroke-dasharray="10,10" />
      
      <!-- Neck detail -->
      <ellipse cx="0" cy="-180" rx="25" ry="15" />
    </g>
    <text x="0" y="250" font-family="Arial" font-size="32" fill="#774936" text-anchor="middle">Handcrafted Pottery</text>
  </g>
</svg>
