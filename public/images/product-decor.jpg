
<!-- This is a base64 encoded image representing home decor items -->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <rect width="800" height="800" fill="#f9f5f0"/>
  <g transform="translate(400, 400)">
    <g stroke="#606c38" stroke-width="10" fill="none">
      <!-- Decorative lamp -->
      <path d="M-50,150 L-50,-50" />
      <path d="M50,150 L50,-50" />
      <path d="M-50,150 L50,150" />
      <path d="M-80,-50 L80,-50" />
      <path d="M-100,-80 L-80,-50" />
      <path d="M100,-80 L80,-50" />
      <path d="M-100,-80 L100,-80" />
      
      <!-- Lampshade -->
      <path d="M-100,-80 C-150,-150 150,-150 100,-80" />
      <ellipse cx="0" cy="-150" rx="60" ry="20" />
      
      <!-- Decorative plant -->
      <path d="M-200,150 L-200,50 C-200,0 -150,0 -150,50 L-150,150" />
      <path d="M-220,50 C-200,-20 -180,30 -170,-30 C-160,20 -140,-20 -130,50" />
      
      <!-- Wall hanging -->
      <path d="M150,0 L250,0" />
      <path d="M200,-100 L200,0" />
      <circle cx="200" cy="-100" r="10" />
      <path d="M200,0 C150,80 250,80 200,0" />
      <path d="M175,40 L225,40" />
    </g>
    <text x="0" y="200" font-family="Arial" font-size="32" fill="#283618" text-anchor="middle">Eco-Friendly Home Decor</text>
  </g>
</svg>
