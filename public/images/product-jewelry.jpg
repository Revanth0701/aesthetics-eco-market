
<!-- This is a base64 encoded image representing handmade jewelry -->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <rect width="800" height="800" fill="#f9f5f0"/>
  <g transform="translate(400, 400)">
    <g stroke="#bc6c25" stroke-width="8" fill="none">
      <!-- Necklace -->
      <path d="M0,-150 C-200,-100 -200,100 0,150 C200,100 200,-100 0,-150" />
      
      <!-- Beads -->
      <circle cx="0" cy="-150" r="25" />
      <circle cx="-70" cy="-135" r="20" />
      <circle cx="-130" cy="-100" r="20" />
      <circle cx="-175" cy="-40" r="20" />
      <circle cx="-175" cy="40" r="20" />
      <circle cx="-130" cy="100" r="20" />
      <circle cx="-70" cy="135" r="20" />
      <circle cx="0" cy="150" r="25" />
      <circle cx="70" cy="135" r="20" />
      <circle cx="130" cy="100" r="20" />
      <circle cx="175" cy="40" r="20" />
      <circle cx="175" cy="-40" r="20" />
      <circle cx="130" cy="-100" r="20" />
      <circle cx="70" cy="-135" r="20" />
      
      <!-- Pendant -->
      <path d="M0,-125 L0,30" />
      <path d="M0,30 L-40,80 L40,80 Z" />
      <circle cx="0" cy="50" r="15" />
    </g>
    <text x="0" y="250" font-family="Arial" font-size="32" fill="#774936" text-anchor="middle">Handcrafted Jewelry</text>
  </g>
</svg>
